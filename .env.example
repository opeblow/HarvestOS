# HarvestOS environment template.
# Copy to `.env` and fill in what you need. Everything below is OPTIONAL except
# the core backend settings — HarvestOS runs fully on the in-app notification
# inbox with local asset storage and no AWS messaging services.

# === Core backend ===
APP_ENV=dev
# Session store: "memory" locally, "aws" for the deployed DynamoDB table.
STORAGE=memory
TABLE_NAME=harvestos-sessions
# Agent backend: "rule" (deterministic, no network) or "bedrock".
AGENT_BACKEND=rule

# === Notifications ===
# Core delivery is always the in-app inbox.
NOTIFICATION_PROVIDER=in_app
# Optional external adapters. Leave "disabled" unless you have enabled and
# configured the matching AWS service. Valid values: disabled | ses (email),
# disabled | eum (sms / whatsapp).
EMAIL_PROVIDER=disabled
SMS_PROVIDER=disabled
WHATSAPP_PROVIDER=disabled

# === Asset storage ===
# "local" (default, git-ignored directory) or "s3".
ASSET_STORAGE=local
ASSET_LOCAL_DIR=.harvestos-assets

# === Dashboard auth (partner console) ===
# Comma-separated browser origins allowed to read the dashboard API.
DASHBOARD_ORIGINS=http://localhost:3000,http://localhost:3001
# Local-only partner sign-in defaults. Replace with secret-store values in production.
HARVESTOS_AUTH_EMAIL=partner@harvestos.local
HARVESTOS_AUTH_PASSWORD=HarvestDemo!2026
# Must be at least 32 characters when APP_ENV=prod.
HARVESTOS_SESSION_SECRET=local-only-change-before-deploy-6cc35149b2d84c71
# ARN of the Secrets Manager secret holding the production session secret
# (JSON key: session_secret). Used by the CDK deploy, not the local backend.
HARVESTOS_AUTH_SECRET_ARN=

# === Frontend ===
HARVESTOS_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3001
NEXT_PUBLIC_LANDING_URL=http://localhost:3000

# === Webhook verification tokens ===
# WhatsApp verification token (you set this; Meta/EUM sends it back on GET).
WHATSAPP_VERIFY_TOKEN=change-me-random-string
# SMS webhook validation token (EUM sends ?auth=<token> on inbound).
SMS_WEBHOOK_AUTH_TOKEN=change-me-random-string

# === Observability (optional) ===
SENTRY_DSN=

# === Payments (optional; Paystack BNPL) ===
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# === AWS (optional) ===
# Only needed for STORAGE=aws, ASSET_STORAGE=s3, EMAIL_PROVIDER=ses,
# SMS_PROVIDER=eum or WHATSAPP_PROVIDER=eum, and for CDK deploys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_ACCOUNT_ID=
# Required only when EMAIL_PROVIDER=ses (the verified SES identity).
SES_FROM_ADDRESS=
# Required only when ASSET_STORAGE=s3.
ASSET_BUCKET=
# Required only when SMS_PROVIDER=eum.
SMS_ORIGINATION_IDENTITY=
# Required only when WHATSAPP_PROVIDER=eum.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_LINKED_ACCOUNT_ID=

# === Optional: local webhook tunneling (ngrok) ===
NGROK_AUTHTOKEN=
NGROK_URL=

# === Optional: only if calling WhatsApp Cloud API directly (prefer AWS EUM Social) ===
META_WHATSAPP_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=

# === Optional: frontend deploy target ===
VERCEL_TOKEN=
