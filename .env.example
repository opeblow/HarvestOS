# === AWS ===
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_ACCOUNT_ID=

# === Sentry (error tracking — see implementation.md §9.4a) ===
SENTRY_DSN=

# === Payments (Paystack, BNPL) ===
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# === Optional: local webhook tunneling (ngrok) ===
NGROK_AUTHTOKEN=

# === Optional: only if calling WhatsApp Cloud API directly (prefer AWS EUM Social) ===
META_WHATSAPP_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=

# === Optional: frontend deploy target ===
VERCEL_TOKEN=

# === Backend runtime ===
APP_ENV=dev
# Comma-separated browser origins allowed to read the dashboard API.
DASHBOARD_ORIGINS=http://localhost:3000,http://localhost:3001
# Local-only partner sign-in defaults. Replace with secret-store values in production.
HARVESTOS_AUTH_EMAIL=partner@harvestos.local
HARVESTOS_AUTH_PASSWORD=HarvestDemo!2026
HARVESTOS_SESSION_SECRET=local-only-change-before-deploy-6cc35149b2d84c71
HARVESTOS_API_URL=http://localhost:8000
HARVESTOS_AUTH_SECRET_ARN=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3001
NEXT_PUBLIC_LANDING_URL=http://localhost:3000
# Local dev runs with in-memory store; set to "aws" when CDK is deployed
HARVESTOS_STORAGE=memory
TABLE_NAME=harvestos-sessions
ASSET_BUCKET=
SES_FROM_ADDRESS=harvestos@example.com
# WhatsApp verification token (you set this; Meta/EUM sends it back on GET)
WHATSAPP_VERIFY_TOKEN=change-me-random-string
# SMS webhook validation token (EUM sends ?auth=<token> on inbound)
SMS_WEBHOOK_AUTH_TOKEN=change-me-random-string
